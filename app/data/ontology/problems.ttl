@prefix ex: <http://example.org/kg-study#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Problem 5.1
ex:Problem5_1 a ex:Problem ;
    rdfs:label "Non-Deterministic LLM Output Breaking AST Parsing" ;
    ex:usesModule ex:Module2, ex:Module4 ;
    ex:hasSolution ex:Solution5_1 .

ex:Solution5_1 a ex:Solution ;
    rdfs:label "Wrap code generation inside ast.parse() and ast.NodeVisitor validation pipeline" ;
    ex:solvesProblem ex:Problem5_1 .

# Problem 5.6
ex:Problem5_6 a ex:Problem ;
    rdfs:label "Unsound Numeric Bounds in Synthesized Code" ;
    ex:usesModule ex:Module4 ;
    ex:hasSolution ex:Solution5_6 .

ex:Solution5_6 a ex:Solution ;
    rdfs:label "Formulate pre/post-conditions into Z3 SMT constraints to check satisfiability before execution" ;
    ex:solvesProblem ex:Problem5_6 .