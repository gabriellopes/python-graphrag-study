@prefix ex: <http://example.org/kg-study#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Problem5_6 a ex:Problem ;
    rdfs:label "Unsound Numeric Bounds in Synthesized Code" ;
    ex:usesModule ex:Module4 ;
    ex:hasPreCondition "val >= 0" ;
    ex:hasPostCondition "val <= 100" ;
    ex:hasSolution ex:Solution5_6 .

ex:Solution5_6 a ex:Solution ;
    rdfs:label "Formulate pre/post-conditions into Z3 SMT constraints to check satisfiability" ;
    ex:solvesProblem ex:Problem5_6 .