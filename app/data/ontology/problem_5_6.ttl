@prefix ex: <http://example.org/kg-study#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Problem5_6 a ex:Problem ;
    rdfs:label "Problem 5_6: Valid Range Bounds Check" ;
    ex:hasPreCondition "val >= 0" ;
    ex:hasPostCondition "val <= 100" ;
    ex:minVal 0 ;
    ex:maxVal 100 ;
    ex:defaultCode """def check_bounds(val: int) -> bool:
    \"\"\"
    Formulate pre/post-conditions into Z3 SMT constraints
    to check satisfiability before execution.
    \"\"\"
    return val >= 0 and val <= 100""" .